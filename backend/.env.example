PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/oneqr
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d

# Frontend URL (no trailing slash)
CLIENT_URL=http://localhost:3000

# Optional cloud file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional SMS provider
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Comma-separated administrator email addresses
ADMIN_EMAILS=

# Government integrations are disabled until authorized provider credentials
# and approved API contracts are configured.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
UIDAI_API_KEY=
NSDL_API_KEY=
